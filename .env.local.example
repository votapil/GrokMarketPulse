# Local Vite + Convex CLI. Never commit filled values.
# Convex actions read keys from `npx convex env set`, not this file.

XAI_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=
RENDER_API_KEY=

# Production Render only (dashboard, sync: false). Not used by `npm run dev`.
CONVEX_DEPLOY_KEY=

# Injected by `npx convex deploy` during the Render build. Do not set by hand.
# VITE_CONVEX_URL=
